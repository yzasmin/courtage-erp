# Copier en `.env` et adapter. Aucun secret reel dans ce fichier : il est versionne.

# Adresse de la base. Sans valeur, le projet utilise SQLite dans le dossier du depot, ce qui suffit
# pour developper et pour lancer les tests.
# COURTAGE_BASE_URL=postgresql+psycopg://courtage:courtage@localhost:5432/courtage

# Graine du generateur de donnees. Deux executions avec la meme graine donnent le meme jeu.
COURTAGE_GRAINE=20261019

# Fin de l'historique simule. Fixee, et non calculee a partir d'aujourd'hui, pour que la generation
# reste reproductible.
COURTAGE_DATE_REFERENCE=2026-09-30

# Identifiants PostgreSQL du compose. A changer pour tout usage autre qu'une demonstration locale.
POSTGRES_USER=courtage
POSTGRES_PASSWORD=courtage
POSTGRES_DB=courtage
POSTGRES_PORT=5432
ERP_PORT=8000

# Agent de pre-remplissage (module 4a), seulement pour `courtage ia ... --mode api`. Sans cle, les
# commandes rejouent les reponses enregistrees dans data/ia/reponses/. Une cle personnelle (prefixe
# sk-ant-usr) exige en plus l'identifiant de l'espace de travail ; une cle d'espace de travail s'en passe.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Limites memoire des conteneurs. Calibrees pour la machine virtuelle Docker de ce poste, environ
# 3,75 Go. A desserrer en integration continue, ou le runner a davantage de memoire.
POSTGRES_MEM_LIMIT=512m
ERP_MEM_LIMIT=512m

# --- Module 2 : orchestration des flux financiers ---------------------------------------------

# Port de l'interface Airflow.
AIRFLOW_PORT=8080

# Compte d'administration Airflow de la demonstration locale. A changer pour tout autre usage : ce
# n'est pas un secret, c'est un identifiant de demonstration, et il est ecrit ici pour que personne ne
# le cherche ailleurs.
AIRFLOW_ADMIN=admin
AIRFLOW_ADMIN_MOTDEPASSE=courtage

# Cle de chiffrement des connexions Airflow. Vide, Airflow en genere une par demarrage, ce qui suffit a
# une demonstration locale puisqu'aucune connexion n'est stockee. A fixer pour un usage durable :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Fenetre de tolerance du rapprochement par montant et date, en jours.
COURTAGE_FENETRE_RAPPROCHEMENT_JOURS=15

# Racine de l'espace de travail des flux : dossier d'arrivee, archive, rejets, bordereaux emis.
# COURTAGE_FLUX_RACINE=./data/flux

# Limites memoire des services Airflow, mesurees avec `docker stats` sur ce poste et non estimees.
# L'ordonnanceur tient dans 768 Mio ; le serveur web en demande davantage.
AIRFLOW_MEM_LIMIT=768m
AIRFLOW_WEB_MEM_LIMIT=1024m
