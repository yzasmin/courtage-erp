/// Apporteur d'affaires du reseau de distribution.
table dim_apporteur
	lineageTag: 1bb38733-1485-5da4-b1b1-91b30fb1da59

	column apporteur_id
		dataType: int64
		isHidden
		lineageTag: 6662e8df-28af-50e6-8580-f4527e6a041c
		summarizeBy: none
		sourceColumn: apporteur_id

	column code_apporteur
		dataType: string
		lineageTag: e1969998-1d0c-56cf-ab6e-93e3762ea725
		summarizeBy: none
		sourceColumn: code_apporteur

	column nom_apporteur
		dataType: string
		lineageTag: 16401fd5-6916-59e1-8792-dfb2224ede94
		summarizeBy: none
		sourceColumn: nom_apporteur

	column type_apporteur
		dataType: string
		lineageTag: 8498869f-84fd-5276-a040-c916121a24e4
		summarizeBy: none
		sourceColumn: type_apporteur

	partition dim_apporteur = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "\dim_apporteur.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"apporteur_id", Int64.Type}, {"code_apporteur", type text}, {"nom_apporteur", type text}, {"type_apporteur", type text}}, "en-US")
				in
				    Types

