/// Prestations, une ligne par remboursement. Relation active : date de reglement.
table fct_prestations
	lineageTag: 61e19faf-21d7-509d-ba3c-c665dd03212a

	column prestation_id
		dataType: int64
		isHidden
		lineageTag: 8f82c423-ac17-5d7e-bcfa-b125c246a0e9
		summarizeBy: none
		sourceColumn: prestation_id

	column date_soins
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: cca4eacc-2a27-529d-85a5-cbfee6488701
		summarizeBy: none
		sourceColumn: date_soins

	column date_reglement
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 3a3aafe0-b86d-505b-b6b5-ca3c04c181e0
		summarizeBy: none
		sourceColumn: date_reglement

	column statut_prestation
		dataType: string
		lineageTag: d8f2a010-0a14-5814-94ec-2983ea788f20
		summarizeBy: none
		sourceColumn: statut_prestation

	column produit_id
		dataType: int64
		isHidden
		lineageTag: f82ec376-9f57-53e4-adad-820653d8814b
		summarizeBy: none
		sourceColumn: produit_id

	column compagnie_id
		dataType: int64
		isHidden
		lineageTag: bb837f3c-f085-50cd-80a4-cb5af35b1de7
		summarizeBy: none
		sourceColumn: compagnie_id

	column branche_id
		dataType: int64
		isHidden
		lineageTag: efc83cb4-963f-58cd-a544-5800e2b04286
		summarizeBy: none
		sourceColumn: branche_id

	column apporteur_id
		dataType: int64
		isHidden
		lineageTag: 1b3c7134-0e6a-5744-abcf-da94dec135a4
		summarizeBy: none
		sourceColumn: apporteur_id

	column adherent_id
		dataType: int64
		isHidden
		lineageTag: 838d8a1d-8bad-5cce-a3cf-1005e9527944
		summarizeBy: none
		sourceColumn: adherent_id

	column demande_euros
		dataType: double
		formatString: #,0.00 €
		lineageTag: f458f2bd-f317-5d51-b2e3-70969002d764
		summarizeBy: sum
		sourceColumn: demande_euros

	column rembourse_euros
		dataType: double
		formatString: #,0.00 €
		lineageTag: 25d52c8f-99b6-51c2-b5e0-094800f62840
		summarizeBy: sum
		sourceColumn: rembourse_euros

	partition fct_prestations = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "\fct_prestations.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"prestation_id", Int64.Type}, {"date_soins", type date}, {"date_reglement", type date}, {"statut_prestation", type text}, {"produit_id", Int64.Type}, {"compagnie_id", Int64.Type}, {"branche_id", Int64.Type}, {"apporteur_id", Int64.Type}, {"adherent_id", Int64.Type}, {"demande_euros", type number}, {"rembourse_euros", type number}}, "en-US")
				in
				    Types

